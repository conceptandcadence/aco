{%- include 'product-tags' -%}

{% capture filter_values %}
    {% for variant in product.variants %}
        {% if variant.available %}
            data-size_{{- variant.title -}}
        {% endif %}
    {% endfor %}
    {% for tag in product.tags %}
        {% if tag contains 'colorway--' %}
            data-colorway-{{- tag | remove: 'colorway--' -}}
        {% endif %}
        {% if tag contains 'Colorway--' %}
            data-colorway-{{- tag | remove: 'Colorway--' -}}
        {% endif %}
    {% endfor %}
{% endcapture %}

<div class="plp-item{% unless product.variants.size > 1 %} no-variants{% endunless %} {{ classes }}" data-id="{{ product.id }}" data-handle="{{ product.handle }}" data-state="default" data-material="{{ material_tag | downcase }}" {{ filter_values }} data-default-variant="{{ product.selected_or_first_available_variant.id }}">
    <div class="plp-item__images">
        {% assign product_hover_enabled = false %}
        {% if product.images[1] %}
          {% assign product_hover_image = product.images[1] %}
          {% assign product_hover_enabled = true %}
        {% else %}
          {% assign product_hover_image = product.images[0] %}
        {% endif %}

        {%- include 'image-size', sizes: '200,400,600,700,800,900,1000,1200', image: product_hover_image -%}
        {%- assign image_url = product_hover_image | img_url: '4x5' -%}
        <img class="plp-item__images-image lazyload-img lifestyle " loading="lazy"
            src="{{ image_url }}"
            data-src="{{ image_url }}"
            data-widths="[{{ supported_sizes }}]"
            sizes="(max-width: 700px) 50vw,33.33vw"
            srcset="{{ image_srcset }}"
            alt="{{ product_hover_image.alt | escape }}">
        <noscript>
            <img class="plp-item__images-image lifestyle" src="{{ product_hover_image | img_url: '400x' }}" alt="{{ product_hover_image.alt | escape }}">
        </noscript>

        {%- include 'image-size', sizes: '200,400,600,700,800,900,1000,1200', image: product.featured_image -%}
        {%- assign image_url = product.featured_image | img_url: '4x5' -%}
        <img class="plp-item__images-image lazyload-img flat " loading="lazy"
            src="{{ image_url }}"
            data-src="{{ image_url }}"
            data-widths="[{{ supported_sizes }}]"
            sizes="(max-width: 700px) 50vw,33.33vw"
            srcset="{{ image_srcset }}"
            alt="{{ product.featured_image.alt | escape }}">
        <noscript>
            <img class="plp-item__images-image placeholder flat" src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.featured_image.alt | escape }}">
        </noscript>
        {% if product.tags contains 'ac-pick' %}
          {% render 'icon-ac-pick' %}
        {% endif %}
      
        {% assign badgeShortsLength = false %}
        {% assign badgePantsLength = false %}
        {% assign lengthTitles = 'Length,Inseam'%}
        {% assign lengths = nil %}
        {% for option in product.options_with_values %}
          {%- if lengthTitles contains option.name and option.values != blank -%}
            {% assign lengths = option.values %}
            {% for length in lengths %}
              {% if length contains '5.5' %}{% assign badgeShortsLength = true %}{% endif %}   
              {% if length contains 'Long' %}{% assign badgePantsLength = true %}{% endif %}                       
            {% endfor %}
          {%- endif -%}
        {% endfor %}  
        {% if badgeShortsLength  %}
          <div class="badge shorts-length">Available in 5.5"</div>
        {% endif %}
        {% if badgePantsLength  %}
          <div class="badge shorts-length">Longer Inseam Available</div>
        {% endif %}
    </div>

    <div class="plp-item__info{% unless product_hover_enabled %} no-hover{% endunless %}">
        <h2 class="plp-item__title">{{ product.title }}</h2>
        <div class="plp-item__title plp-item__price">
        {% if product.tags contains 'gift-card'%}
            {{ product.price_min | money | remove: '.00' }}&ndash;{{ product.price_max | money | remove: '.00' }}
        {% else %}
            {% if product.price_varies %}
                {{ product.price_max | money | remove: '.00' }}
            {% else %}
                <span class="sale-price">{{ product.price | money | remove: '.00' }}{% if localization.country.iso_code == 'CA' %} {{ localization.country.currency.iso_code }}{% endif %}</span>
                {% if product.compare_at_price > product.price %}
                    <s>{{ product.compare_at_price | money | remove: '.00' }}</s>
                    {% assign price_difference = product.compare_at_price | minus: product.price %}
                    {% assign percentage_difference = product.price | times: 1.00 | divided_by: product.compare_at_price %}
                    {% assign percentage_difference = 1 | minus: percentage_difference | times: 100 | round | append: '% Off' %}
                    <span class="discount-percentage">{{ percentage_difference }} {% if localization.country.iso_code == 'CA' %}{{ localization.country.currency.iso_code }}{% endif %}</span>
                {% endif %}
            {% endif %}
        {% endif %}
        </div>
    </div>

    <a class="plp-item__link" href="{{ product.url | within: collection }}"><span class="visually-hidden">View {{ product.title }}</span></a>

      <div class="plp-item__purchase">
          <div class="plp-item__sizes">
            {% assign sizes = nil %}
            {% assign size_option_position = nil %}
            {% assign lengths = nil %}
            {% assign length_option_position = nil %}
            {% for option in product.options_with_values %}
                {%- if option.name == "Size" and option.values != blank -%}
                  {% assign sizes = option.values %}
                  {% assign size_option_position = option.position %}
                  {% capture size_variant_option %}option{{- option.position -}}{% endcapture %}
                {%- endif -%}
                {%- if option.name == "Length" and option.values != blank -%}
                  {% assign lengths = option.values %}
                  {% assign length_option_position = option.position %}
                  {% capture length_variant_option %}option{{- option.position -}}{% endcapture %}
                {%- endif -%}
            {% endfor %}  
            {% if product.options.size > 1 %} 
              <ul class="plp-item__size-list multiple"> 
                  {% assign used_options = 'size_' %}
                  {% for variant in product.variants %}
                    {% assign formatted_size = 'size_' | append: variant[size_variant_option] %}
                    {%- unless used_options contains formatted_size -%}
                      <li class="variant-size soldout" tabindex="0" {% if product.metafields.custom_fields["details_model"] != blank %} data-size-note="{{ product.metafields.custom_fields["details_model"] | strip_html | escape }}"{% endif %}>                         
                        <input type="radio" name="size" value="{{variant[size_variant_option]}}" id="size_{{variant[size_variant_option]}}" {%if forloop.first%} checked="checked" {%endif%}  tabindex="-1"/> 
                        <label class="label" for="size_{{ variant[size_variant_option] }}" tabindex="-1">{{ variant[size_variant_option] }}</label>
                      </li> 
                      {% assign used_options = used_options | append: formatted_size | append: ', ' %}
                    {%- endunless -%}
                  {% endfor %}
              </ul>
              <ul class="plp-item__size-list plp-item__lengths"> 
                  {% assign used_options = '' %}
                  {% for length in lengths %}
                    <li class="variant-length soldout {% if forloop.first %}selected{% endif %}" tabindex="0" 
                      {% if product.metafields.custom_fields["details_model"] != blank %} data-size-note="{{ product.metafields.custom_fields["details_model"] | strip_html | escape }}"{% endif %}>                         
                      <input type="radio" name="id" value="{{length | escape}}" id="length_{{length | escape}}" {%if forloop.first%} checked="checked" {%endif%}  tabindex="-1"/> 
                      <label class="label" for="length_{{length | escape}}" tabindex="-1">{{ length | escape }}</label>
                    </li> 
                  {% endfor %}
              </ul>
            {% else %}
              <ul class="plp-item__size-list"> 
                  {% assign used_options = 'size_' %}
                  {% for variant in product.variants %}
                    {% assign formatted_size = 'size_' | append: variant[size_variant_option] %}
                    {%- unless used_options contains formatted_size -%}
                      <li class="variant{% unless variant.available  %} soldout{% endunless %}{% if variant.metafields.custom_fields["preorder_estimated_ship_date"] != blank %} preorder{% endif %}" 
                          data-variant="{{ variant.title }}"
                          data-variant-id="{{ variant.id }}"
                          data-product="{{ product.title | escape }} / {{ variant.title }}"
                          data-price="{{- variant.price | money_without_currency | remove: '.00' -}}"
                          data-compare-price="{{- variant.compare_at_price | money_without_currency | remove: '.00' -}}">                         
                          <span class="label">{{ variant.title }}</span>
                      </li> 
                      {% assign used_options = used_options | append: formatted_size | append: ', ' %}
                    {%- endunless -%}
                  {% endfor %}
              </ul>
            {% endif %}
          </div>
          <div class="plp-item__button" data-variant="">
              <span class="default">Quick Add</span>
              <span class="add">Add to cart</span>
              <span class="select-size">Select a size</span>
              <span class="adding">Adding to cart...</span>
              <span class="success">Added to cart!</span>
              <span class="error">Sorry there was a problem</span>
              <span class="soldout">Out of Stock</span>
          </div>
      </div>

    <script>window.productTags = {{ product.tags | json }};</script> 
    <style>
    .badge.shorts-length {
        display: block;
        position: absolute;
        bottom: 20px;
        left: 12px;
        width: auto;
        border-radius: 20px;
        background-color: var(--color-blue-bright);
        padding: 3px 10px;
        font-size: 12px;
        color: #fff;
    }
    @media (min-width: 700px) {
    .badge.shorts-length {
            left: 20px;
            bottom: 24px;
        }
    }
    </style>
    <script>window.plpProducts['{{- product.handle -}}'] = {{ product | json }}</script>
</div>

