									{% if block.type == 'form' %}									
										{%- form 'contact', class: 'Form Form--spacingTight' -%}
												{%- if form.posted_successfully? -%}
													<p class="ProductForm__Title Alert Alert--success">{{ 'contact.wholesale.post_success' | t }}</p>
												{%- endif -%}

												{%- if form.errors -%}
												<div class="Form__Alert Alert Alert--error">
														<ul class="Alert__ErrorList">
														{%- for field in form.errors -%}
																{%- if field == 'form' -%}
																<li class="Alert__ErrorItem">{{ form.errors.messages[field] }}</li>
																{%- else -%}
																<li class="Alert__ErrorItem"><strong>{{ form.errors.translated_fields[field] }}</strong> {{ form.errors.messages[field] }}</li>
																{%- endif -%}
														{%- endfor -%}
														</ul>
												</div>
												{%- endif -%}

                        <input type="hidden" class="Form__Input" name="contact[wholesale]" value="Website Wholesale Inquiry">


												<div class="Form__Group">
														<div class="Form__Item">
																<input type="text" class="Form__Input" name="contact[name]" aria-label="Name" placeholder="Name" required {% if customer %}value="{{ customer.name }}"{% endif %}>
																<label class="Form__FloatingLabel u-h6">Name</label>
														</div>
												</div>

												<div class="Form__Group">
														<div class="Form__Item">
																<input type="email" class="Form__Input" name="contact[email]" aria-label="Email" placeholder="Email" required {% if customer %}value="{{ customer.email }}"{% endif %}>
																<label class="Form__FloatingLabel u-h6">Email</label>
														</div>
												</div>

												<div class="Form__Group">
														<div class="Form__Item">
																<input type="tel" class="Form__Input" name="contact[phone]" aria-label="Phone number" placeholder="Phone number" required {% if customer %}value="{{ customer.phone }}"{% endif %}>
																<label class="Form__FloatingLabel u-h6">Phone number</label>
														</div>
												</div>

												<div class="Form__Group">
														<div class="Form__Item">
																<input type="tel" class="Form__Input" name="contact[event_date]" aria-label="Event Date" placeholder="Event Date" required {% if customer %}value="{{ customer.phone }}"{% endif %}>
																<label class="Form__FloatingLabel u-h6">Event Date</label>
														</div>
												</div>

												<div class="Form__Group">
														<div class="Form__Item Form__Item--Flex">
																<label class="Form__SelectLabel u-h6">Number of suits needed</label>
                                <select class="Form__Select" name="contact[number_of_suits]" aria-label="Number of suits" required>
                                  <option value="10+">5+</option>
                                  <option value="10+">10+</option>
                                  <option value="10+">20+</option>
                                  <option value="10+">30+</option>
                                  <option value="10+">40+</option>
                                  <option value="10+">50+</option> 
                                </select>
														</div>
												</div>

												<div class="Form__Item">
														<label class="Form__FloatingLabel u-h6 textarea">Any notes or special requests?</label> 
														<textarea name="contact[notes]" cols="30" rows="10" class="Form__Textarea" aria-label="Any notes, custom colors, etc." placeholder="Any notes, custom colors, etc."></textarea>
												</div>

												<button type="submit" class="Form__Submit button button--primary button--full" style="font-size: 14px; width: 100%;">{{ 'contact.wholesale.submit' | t }}</button>
										{%- endform -%}
