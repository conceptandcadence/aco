<style>
  .adset:not(.active) {
    display: none !important;
  }
  .adset.active {
    grid-column-end: span 2;
    border-bottom: 0 !important;
    margin: -1px !important;
  }  
  @media (min-width: 700px) {
    .adset.active {
      grid-column-end: span 3;
    }
  }

@media (min-width: 700px) {
    #shopify-section-template--16004355981401__166266523192c5ec88 .lp-banner-full__foreground {
        padding-top: 0;
    }
}
  
</style>

<script>
  if (window?.location?.search) {
    let params = new URLSearchParams(window.location.search);
    let entries = params.entries();
    params = Object.fromEntries(entries);
    console.log(params);
    if (params?.adset) {
      let adset = document.querySelector(`.adset[data-id="${params?.adset}"]`);
      adset.classList.add('active');
      console.log(`Adset ${params?.adset} has been activated`);

      adset.querySelectorAll(`.plp-item`).forEach((adsetProduct => {
        document.querySelectorAll(`.welcome-products > .plp-item`).forEach((product => {
          if (product.dataset.id === adsetProduct.dataset.id) {
            product.remove();
          }
        }));
      }));
      console.log('adset', adset)

      if (adset?.dataset?.adset_hero_m) {
        console.log('adset_hero_m',document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.mobile'));
        document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.mobile').srcset = '';
        document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.mobile').src = adset?.dataset?.adset_hero_m;
      }
      if (adset?.dataset?.adset_hero_d) {
        console.log('adset_hero_d',document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.desktop'));
        document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.desktop').srcset = '';
        document.querySelector('.c-lp-banner-full .lp-banner-full__background .banner-background.desktop').src = adset?.dataset?.adset_hero_d;
      }
      if (adset?.dataset?.adset_title) {
        console.log('adset_title',document.querySelector('.c-lp-banner-full .lp-banner-full__foreground .banner-item.image'));
        document.querySelector('.c-lp-banner-full .lp-banner-full__foreground .banner-item.image').src = adset?.dataset?.adset_title;
      }
    }
  }
</script>
<style id="welcome-product-styles"></style>
{% schema %}
  {
    "name": "Ad Sets",
    "class": "product-listing featured-products",
    "settings": [
        {
            "type": "range",
            "id": "product_count",
            "label": "Product Count",
            "min": 6,
            "max": 48,
            "step": 1,
            "unit": "cel",
            "default": 18,
            "info": "The number of products that will be initially loaded."
        },
        {
            "type":"collection",
            "id":"collection",
            "label":"Collection"
        },
        {
            "type":"text",
            "id":"title",
            "label":"Title"
        }
    ],
    "blocks":[
        {
        "type":"look",
        "name":"Ad Set",
        "settings":[
            {
                "type":"text",
                "id":"title",
                "label":"Handle"
            },
            {
                    "type": "image_picker",
                    "id": "hero_mobile",
                    "label": "Hero Image Mobile"
            },
            {
                    "type": "image_picker",
                    "id": "hero_desktop",
                    "label": "Hero Image Desktop"
            },
            {
                    "type": "image_picker",
                    "id": "title_graphic",
                    "label": "Title Graphic"
            },
            {
                "type":"product",
                "id":"product_1",
                "label":"Product 1"
            },  
            {
                "type":"product",
                "id":"product_2",
                "label":"Product 2"
            },  
            {
                "type":"product",
                "id":"product_3",
                "label":"Product 3"
            },  
            {
                "type":"product",
                "id":"product_4",
                "label":"Product 4"
            },  
            {
                "type":"product",
                "id":"product_5",
                "label":"Product 5"
            },  
            {
                "type":"product",
                "id":"product_6",
                "label":"Product 6"
            }, 
          ]
        }
    ],
      "presets": [
      {
        "name": "Ad Sets",
        "category": "Collections"
      }]
  }
{% endschema %}