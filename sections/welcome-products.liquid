<section class="plp-products welcome-products" id="shop-container" data-collection-title="{{ section.settings.title }}" data-collection-index="{{ section.index0 }}">

  {% if section.settings.title != blank %}
  <div class="featured-products-banner">
    <span class="featured-products-banner__text h3">
      {{ section.settings.title }}
    </span>
  </div>
{% endif %}
  {% assign collection = collections[section.settings.collection] %}
  
      {% if collection.products.size > 0 %}
        
        {% assign prioritized_products = '' %}
        {% for block in section.blocks %}
          <section class="adset plp-products" data-id="{{ block.settings.title }}" {% if block.settings.hero_mobile != blank %}data-adset_hero_m="{{ block.settings.hero_mobile | img_url: 'x900' }}"{% endif %} {% if block.settings.hero_desktop != blank %}data-adset_hero_d="{{ block.settings.hero_desktop | img_url: 'x1200' }}"{% endif %} {% if block.settings.title_graphic != blank %}data-adset_title="{{ block.settings.title_graphic | img_url }}"{% endif %}>

          {% if block.settings.product_1 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_1 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_1] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}

          {% if block.settings.product_2 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_2 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_2] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}

          {% if block.settings.product_3 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_3 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_3] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}

          {% if block.settings.product_4 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_4 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_4] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}

          {% if block.settings.product_5 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_5 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_5] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}

          {% if block.settings.product_6 != blank %}
            {% assign in_collection = false %}
            {% for product in collection.products %}
              {% if product.handle == block.settings.product_6 %}
                {% include 'plp-item', product: product %}
                {% assign in_collection = true %}
              {% endif %}
            {% endfor %}
            {% if in_collection == false %}
              {% assign product = all_products[block.settings.product_6] %}
              {% include 'plp-item', product: product %}
            {% endif %}
            {% assign prioritized_products = prioritized_products | append: product.id | append: ', ' %}
          {% endif %}
          </section>
        {% endfor %}
        {% paginate collection.products by section.settings.product_count %} 
          {% for product in collection.products %}
            {% unless prioritized_products contains product.id %}
              {% include 'plp-item' %}
            {% endunless %}
          {% endfor %}

          {%- if paginate.pages > 1 -%}
            <div class="plp-products__pagination">
              {{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}
            </div>
          {%- endif -%}
          
        {% endpaginate %}
        
      {% else %}
        <div class="plp-products__no-matches">
            <h2>Sorry</h2>
            <p>{{ 'collections.general.no_matches' | t }}{% if current_tags != blank %} Please remove some filters and try again.{% endif %}</p>
            {% assign gender = 'men' %}
            {% for tag in current_tags %}
                {% if tag contains 'women' %}
                    {% assign gender = 'women' %}
                {% endif %}
            {% endfor %} 
            <a href="/collections/{{ gender }}" class="button button--primary shop-all" style="font-size: 14px; margin-top: 12px; display: inline-block;">Shop All</a>
        </div>
        <style>
            .plp-products { display: flex !important; flex-direction: column; justify-content: center; align-items: center; }
            .shop-all.button.button--primary:before {
                background-color: var(--color-blue-dark) !important;
            }
        </style>
      {% endif %}



  
</section>

