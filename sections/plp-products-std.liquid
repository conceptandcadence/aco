                "label":"Collection"
            },
            {
                "type": "range",
                "id": "placement",
                "label": "Collection Placement",
                "min": 1,
                "max": 100,
                "step": 1,
                "unit": "prd",
                "default": 12,
                "info": "This will be displayed in the Nth slot in the collection. To avoid white spaces, this should be a multiple of 6, plus one. Ex: 7, 13"
