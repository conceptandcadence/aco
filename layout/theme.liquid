    border-top: solid 1px var(--color-grey-soft) !important;
}  
.c-hp-press-carousel .hp-press-carousel .hp-press-carousel__quotes .flickity-button {
  background: none !important;
  width: 24px !important;
  height: 24px !important;
}
</style>  

<script>
  if (!document.querySelector('.site-banner')) {
    document.querySelector('body').classList.remove('site-banner--active');
  }
</script>

<div data-rebuy-id="120088"></div>
