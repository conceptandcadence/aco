  }
}
.hp-press-carousel__reviewer {
  font-weight: 500 !important;
}

.plp-header .plp-header__title {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 24px
}
@media (min-width: 700px) {
  .c-hp-products .hp-products .hp-products__products .flickity-button.next {
      right: 15px;
